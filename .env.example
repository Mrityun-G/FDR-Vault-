# API server settings (copy to .env for local use; on a host, set them as environment variables).
# Never commit real values. Only the server reads these; the front ends hold no secrets.

# PostgreSQL connection (the role must own the database and be allowed to CREATE ROLE once, for anon/authenticated)
DATABASE_URL=postgres://fdrvault_app:change-me@localhost:5432/fdrvault
DATABASE_SSL=false                 # true for hosted databases that require TLS from outside their network
DB_POOL_SIZE=10

# Address of this API server as the browser sees it (used in email links and Google's redirect URI)
PUBLIC_URL=http://localhost:8787
PORT=8787

# Signing key for access tokens and download links — at least 32 random characters
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Front-end origins allowed to call the API and to be returned to after email links / Google sign-in.
# https://localhost is the Android (Capacitor) app. Leave empty in local development to allow any localhost origin.
ALLOWED_ORIGINS=https://fdr-vault.vercel.app,https://fdr-vault-sbf7.vercel.app,https://localhost

# Email (confirmation links, sign-in codes, password reset). Without SMTP_HOST, emails are printed to the server log
# and new accounts are confirmed at sign-up.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AICTE Portal <no-reply@example.com>
# REQUIRE_EMAIL_CONFIRMATION=true  # defaults to true when SMTP_HOST is set

# Google sign-in (Google Cloud Console → Credentials → OAuth client). Authorised redirect URI: <PUBLIC_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude document reading (optional; without it the app shows its on-device preview)
ANTHROPIC_API_KEY=

# Daily FDR expiry reminders at 01:30 UTC (set false on extra instances so only one runs it)
RUN_SCHEDULER=true
